#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D equirect;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray outCube;

const float PI = 3.14159265;

vec3 faceDirection(uint face, vec2 uv)
{
	// uv in [-1, 1]. Vulkan cubemap face order: +X -X +Y -Y +Z -Z
	if (face == 0) return vec3(1.0, -uv.y, -uv.x);
	if (face == 1) return vec3(-1.0, -uv.y, uv.x);
	if (face == 2) return vec3(uv.x, 1.0, uv.y);
	if (face == 3) return vec3(uv.x, -1.0, -uv.y);
	if (face == 4) return vec3(uv.x, -uv.y, 1.0);
	return vec3(-uv.x, -uv.y, -1.0);
}

vec2 dirToEquirect(vec3 dir)
{
	dir = normalize(dir);
	float u = atan(dir.z, dir.x) / (2.0 * PI) + 0.5;
	float v = acos(clamp(dir.y, -1.0, 1.0)) / PI;
	return vec2(u, v);
}

void main()
{
	ivec3 id = ivec3(gl_GlobalInvocationID);
	ivec2 size = imageSize(outCube).xy;
	if (id.x >= size.x || id.y >= size.y || id.z >= 6) {
		return;
	}

	vec2 uv = (vec2(id.xy) + 0.5) / vec2(size) * 2.0 - 1.0;
	vec3 dir = faceDirection(uint(id.z), uv);
	vec3 color = texture(equirect, dirToEquirect(dir)).rgb;
	imageStore(outCube, id, vec4(color, 1.0));
}
